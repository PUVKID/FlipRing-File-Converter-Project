-            if kind == QEvent.Show:
-                if isinstance(self.parent(), QAbstractItemView):
-                    self._connect_view()
-                self.pulse()
-        elif kind in (QEvent.Enter, QEvent.FocusIn, QEvent.MouseButtonPress, QEvent.KeyPress):
