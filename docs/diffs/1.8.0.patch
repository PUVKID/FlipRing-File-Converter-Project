+                          (QFileDialog.FileType, "dialog_filter"), (QFileDialog.Reject, "cancel"),
+                          (QFileDialog.Accept, "dialog_choose" if self.folder_mode else "dialog_open")):
+            self.setLabelText(role, tr(self.language, key))
