+        self.pages.setText(values["pages"])
+        self.quality.setValue(values["quality"])
+        self.dpi.setValue(values["dpi"])
+        self.force.setChecked(values["force_ocr"])
+        self.source_tabs.setCurrentIndex(0)
+        return True
