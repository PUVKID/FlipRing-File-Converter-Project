+SOURCE_ZIP_NAME = "플립링-1.14.0-전체소스.zip"
+RELEASE_URL = "https://github.com/PUVKID/FlipRing-File-Converter-Project/releases/tag/v1.14.0"
+SOURCE_URL = "https://github.com/PUVKID/FlipRing-File-Converter-Project/releases/download/v1.14.0/" + "FlipRing-1.14.0-Source.zip"
