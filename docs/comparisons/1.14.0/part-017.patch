+    def set_svg(self, path):
+        self.svg_icons = {(dark, selected): svg_icon(path, color)
+                          for dark, selected, color in ((False, False, "#474747"), (False, True, "#0c0c0c"),
+                                                       (True, False, "#b8b8b8"), (True, True, "#f3f3f3"))}
+
+    def _frame(self, value):
+        self.amount = float(value)
+        self.update()
+
+    def transition(self):
+        target = 1.0 if self.hovered or self.isChecked() else 0.0
+        self.motion.stop()
+        if abs(target - self.amount) < 0.001:
+            self.update()
+            return
+        with QSignalBlocker(self.motion):
+            self.motion.setStartValue(self.amount)
+            self.motion.setEndValue(target)
+            self.motion.setCurrentTime(0)
+        start_motion(self.motion)
+
+    def enterEvent(self, event):
+        self.hovered = True
+        self.transition()
+        super().enterEvent(event)
+
+    def leaveEvent(self, event):
+        self.hovered = False
+        self.transition()
+        super().leaveEvent(event)
