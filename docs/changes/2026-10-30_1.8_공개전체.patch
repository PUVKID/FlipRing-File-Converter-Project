+def _serialized_pdfium(function):
+    """PDF 도구와 미리보기가 같은 네이티브 런타임에 동시에 진입하지 않는다."""
+    @wraps(function)
+    def guarded(*args, **kwargs):
+        with PDFIUM_LOCK:
+            return function(*args, **kwargs)
+    return guarded
