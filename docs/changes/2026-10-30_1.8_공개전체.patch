+                writer.compress_identical_objects(remove_duplicates=True, remove_unreferenced=True)
+            output = work / "result.pdf"
+            _write_pdf(writer, output)
+            complete(output, source, request.operation)
+    progress(len(paths), len(paths), "")
+    return outputs
