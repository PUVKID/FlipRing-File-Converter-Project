+                layout.addWidget(widget, y + 1, 0, height, columns)
+            else:
+                layout.addWidget(widget, y + 1, x, height, width)
+        elif item.layout() is not None:
+            layout.addLayout(item.layout(), y + 1, x, height, width)
+        else:
+            layout.addItem(item, y + 1, x, height, width)
