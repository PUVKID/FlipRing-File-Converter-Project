+def _write_pdf(writer, destination, cancel):
+    try:
+        pdf_tools.check_cancel(cancel)
+        if not writer.pages:
+            raise ValueError("페이지가 없는 PDF를 저장할 수 없습니다.")
+        writer.write(str(destination))
+        pdf_tools.check_cancel(cancel)
+    finally:
+        writer.close()
