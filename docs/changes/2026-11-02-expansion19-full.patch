+
+    def _render_preflight(self):
+        lines = [self.tr_text("preflight_line", folder=Path(row["directory"]).name or row["directory"],
+                              estimated=(row["estimated"] + 1024 * 1024 - 1) // (1024 * 1024),
+                              free=row["free"] // (1024 * 1024)) for row in self._preflight_checks]
+        text = "\n".join(lines + [self.tr_text("preflight_note")]) if lines else ""
+        tooltip = "\n".join(row["directory"] for row in self._preflight_checks)
+        for label in (self.preflight_label, self.editor_preflight_label):
+            label.setText(text)
+            label.setToolTip(tooltip)
+            label.setVisible(bool(lines))
