++        image = _flat(image)
++    image.save(destination, format={"jpg": "JPEG", "tiff": "TIFF"}.get(destination.suffix[1:], destination.suffix[1:].upper()),
++               quality=quality, dpi=(dpi, dpi), optimize=True)
