++class _Job(QThread):
++    completed = Signal(object)
++    failed = Signal(object)
++
++    def __init__(self, operation, parent):
++        super().__init__(parent)
++        self.operation = operation
++        self.cancel = threading.Event()
++
++    def run(self):
++        try:
