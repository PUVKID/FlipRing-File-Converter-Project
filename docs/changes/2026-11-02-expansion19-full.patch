+@contextmanager
+def _engine_cancel(cancel):
+    previous = getattr(engine._CONTEXT, "cancel", None)
+    engine._CONTEXT.cancel = cancel
+    try:
+        yield
+    finally:
+        engine._CONTEXT.cancel = previous
