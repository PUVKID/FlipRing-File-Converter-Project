+def safe_member(root, name):
+    # 압축 안의 절대 경로·상위 경로·Windows 장치 경로를 거부한다.
+    clean = name.replace("\\", "/")
+    if ":" in clean or clean.startswith("/") or ".." in clean.split("/"):
