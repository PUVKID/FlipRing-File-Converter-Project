+def _input_paths(paths):
+    if not isinstance(paths, (list, tuple)) or not paths or len(paths) > 10000:
+        raise ValueError("작업할 파일을 선택해 주세요.")
+    result = []
+    for raw in paths:
+        path = Path(raw).resolve(strict=True)
+        if not path.is_file():
+            raise ValueError("작업 공간은 일반 파일만 지원합니다.")
+        result.append(path)
+    return result
