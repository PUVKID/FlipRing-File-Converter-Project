+def select_in_explorer(path):
+    """파일을 실행하지 않고 탐색기에서 해당 파일을 선택한다."""
+    filename = str(Path(path).resolve())
+
+    def check(result, operation):
+        # HRESULT는 64비트 Windows에서도 부호 있는 32비트 값이다.
+        if ctypes.c_int32(result).value < 0:
