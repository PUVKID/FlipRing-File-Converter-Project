+
+    def dispatch_wheel(self, paths, fmt):
+        if fmt == 'recipe':
+            recipe = self.workspace_panel.wheel_recipe()
+            if recipe is not None:
+                self.workspace_panel.set_files(paths)
+                self.tabs.setCurrentIndex(6)
