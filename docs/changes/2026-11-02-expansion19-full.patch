+    def cancel_jobs(self):
+        for entry in self.jobs:
+            if entry['state'] in ('waiting', 'processing'):
+                entry['cancel'].set()
+                entry['state'] = 'cancelling' if entry['scheduled'] else 'cancelled'
+        self.refresh_queue()
