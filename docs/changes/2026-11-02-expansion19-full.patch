+        rows = math.ceil(len(images) / columns)
+        size = columns * width + (columns + 1) * padding, rows * height + (rows + 1) * padding
+        if size[0] * size[1] > _MAX_PIXELS:
+            raise ValueError("콜라주가 4000만 픽셀을 초과합니다.")
+        combined = Image.new("RGB", size, "white")
