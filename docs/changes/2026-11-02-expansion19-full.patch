+        if reader.is_encrypted:
+            raise PdfToolError("encrypted_pdf")
+        if not reader.pages:
+            raise PdfToolError("empty_pdf")
+        return reader
+    except PdfToolError:
+        raise
+    except Exception as exc:
+        raise PdfToolError("invalid_pdf", str(exc)) from exc
