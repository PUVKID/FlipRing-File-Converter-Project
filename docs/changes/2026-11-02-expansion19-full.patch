++def _directory(path, fallback):
++    directory = Path(path).resolve() if path is not None else Path(fallback).resolve()
++    directory.mkdir(parents=True, exist_ok=True)
++    if not directory.is_dir():
++        raise ValueError("결과 폴더를 확인해 주세요.")
++    return directory
