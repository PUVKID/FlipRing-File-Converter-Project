+            x = padding + index % columns * (width + padding) + (width - image.width) // 2
+            y = padding + index // columns * (height + padding) + (height - image.height) // 2
+            combined.paste(image, (x, y), image.getchannel("A") if image.mode == "RGBA" else None)
