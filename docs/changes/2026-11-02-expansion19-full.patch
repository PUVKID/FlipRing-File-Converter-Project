+                loop = QEventLoop()
+                timer = QTimer(loop)
+                timer.setSingleShot(True)
+                timer.setTimerType(Qt.PreciseTimer)
+                dispatcher = QAbstractEventDispatcher.instance()
+                active = [True]
+                expired = [False]
+                observed_jobs = set()
+                job_connections = []
+
+                def completion_gate(*unused):
+                    if not active[0]:
+                        return
+                    job = dialog.job
+                    if job is not None and job not in observed_jobs:
+                        observed_jobs.add(job)
