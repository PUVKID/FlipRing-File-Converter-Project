+        for i in range(n):
+            spread = (i - (n-1)/2) * (75 - 23*self.phase if self.state == 'working' else 65)
+            x = center - 33 + spread
+            y = 17 + abs(i-(n-1)/2)*6 - (8*self.phase if self.state == 'complete' else 0)
+            p.setPen(Qt.NoPen)
