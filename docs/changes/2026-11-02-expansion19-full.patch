++class PageCanvas(QWidget):
++    """표시 좌표를 원본의 정규화 좌표로 변환하며 선택만 표시한다."""
++    rectangle_added = Signal(object)
++
++    def __init__(self, parent=None):
++        super().__init__(parent)
++        self.image = QImage()
++        self.zoom = 100
++        self.regions = []
++        self.words = []
++        self.highlight = None
++        self.drawing = False
++        self.anchor = None
++        self.cursor_position = None
++        self.placeholder = ''
