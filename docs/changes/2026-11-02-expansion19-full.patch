+_IMAGE_FORMATS = {"png", "jpg", "webp", "tiff", "avif", "bmp", "gif"}
+_STORE_LOCK = threading.RLock()
+_RESERVED = re.compile(r"^(CON|PRN|AUX|NUL|COM[1-9¹²³]|LPT[1-9¹²³])(?:\.|$)", re.I)
+_INVALID_NAME = re.compile(r'[<>:"/\\|?*\x00-\x1f]')
