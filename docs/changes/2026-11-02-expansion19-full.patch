+    def _preflight_failed(self, error):
+        self._error = error
+        self._preflight_failure_source = getattr(error, "source", "")
+        self._show_preflight(getattr(error, "preflight_checks", []))
+        self._render_status()
+
+    def _schedule_render(self, *unused):
+        if self._refreshing_pages or self.workspace is None or self._pool is None:
+            return
+        if self._busy:
+            self._render_pending = True
+            return
+        if not self._render_scheduled:
+            self._render_scheduled = True
+            QTimer.singleShot(0, self._render_workspace)
