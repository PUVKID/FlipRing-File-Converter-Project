+                                  else self.options[self.hover].upper()) if active else "×")
+        painter.setPen(QColor("#c7c7c7"))
+        painter.setFont(ui_font(7))
+        painter.drawText(QRectF(center - 50, center + 17, 100, 21), Qt.AlignCenter,
