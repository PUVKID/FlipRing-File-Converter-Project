+            p.drawText(QRectF(x+3,y+36,57,25),Qt.AlignCenter,self.formats[i] if i<len(self.formats) else '+')
+        p.setPen(QPen(QColor('#333333'),2))
+        p.setBrush(Qt.NoBrush)
+        ring = QRectF(center+100,36,36,36)
