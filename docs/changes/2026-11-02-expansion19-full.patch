+
+def targets(paths):
+    common = None
+    for p in paths:
+        try:
+            kind, ext = classify(p)
+        except ValueError:
+            return []
+        options = [x for x in TABLE[kind][1].split() if x != ext]
+        common = options if common is None else [x for x in common if x in options]
+    return common or []
