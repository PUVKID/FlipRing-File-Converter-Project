++def audit_file(path, cancel=None):
++    check_cancel(cancel)
++    source, findings, seen = _source(path), [], {}
++    info = _info(source, cancel)
++    for index in range(info['page_count']):
++        check_cancel(cancel)
++        image = render_page(source, index, 120)
