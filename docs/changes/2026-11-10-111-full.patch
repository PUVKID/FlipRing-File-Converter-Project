+                    self.assertEqual("xs:string", data.get(oor + "type"))
+                    self.assertEqual("fuse", data.get(oor + "op"))
+                    self.assertIsNotNone(data.find("value"))
+                    self.assertIn(data.find("value").text, (None, ""))
+
+
+if __name__ == "__main__":
+    unittest.main()
