+        raise ctypes.WinError(ctypes.get_last_error())
+    deadline = tree.cleanup_deadline
+    while True:
+        active = tree.collect()
+        waiting = False
+        for handle in tree.process_handles.values():
+            status = tree.kernel.WaitForSingleObject(handle, 0)
+            if status == 258:
+                waiting = True
+            elif status != 0:
+                raise ctypes.WinError(ctypes.get_last_error())
+        if not active and not waiting:
+            return
