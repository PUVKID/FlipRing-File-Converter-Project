+        items = []
+        while layout.count():
+            item = layout.itemAt(0)
+            position = layout.getItemPosition(0)
+            items.append((layout.takeAt(0), position))
+        layout.setContentsMargins(24, 22, 24, 20)
+        layout.setHorizontalSpacing(12)
