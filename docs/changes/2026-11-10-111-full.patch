++def _variable(stream, limit, first=None):
++    value = 0
++    for shift in range(limit):
++        part = first if shift == 0 and first is not None else stream.read(1)
++        if not part:
++            _fail('잘린 레코드 머리말')
++        value |= (part[0] & 127) << (7 * shift)
++        if not part[0] & 128:
++            return value
