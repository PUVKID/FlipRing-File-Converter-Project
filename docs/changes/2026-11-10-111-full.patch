+"""별도로 준비한 공개 원형 표본으로 HWP·HWPX·XLSB·암호 XLS를 검사한다.
+
+표본은 저작권에 따라 별도 보관한다. 환경 변수로 표본 폴더를 지정할 수 있으며,
+준비되지 않은 경우 건너뛰기를 성공으로 집계하지 않고 명확하게 실패한다.
+"""
+from pathlib import Path
+from datetime import datetime
+import hashlib
+import os
+import shutil
