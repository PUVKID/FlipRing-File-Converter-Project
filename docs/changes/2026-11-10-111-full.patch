+        self.zoom_out_button.clicked.connect(lambda: self.set_zoom(self.zoom_factor / 1.25))
+        self.zoom_in_button.clicked.connect(lambda: self.set_zoom(self.zoom_factor * 1.25))
+        self.fit_button.clicked.connect(self.fit)
