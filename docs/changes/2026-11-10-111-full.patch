+"""문서 확장 검사의 실제 ID·건너뜀·수행 수를 기록합니다."""
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
