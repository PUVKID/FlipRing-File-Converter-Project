+        if not Path(path).is_file(): self.set_status('ws_failed',self.t('ws_missing')); return
+        if as_file:
+            mime=QMimeData(); mime.setUrls([QUrl.fromLocalFile(path)]); QApplication.clipboard().setMimeData(mime)
