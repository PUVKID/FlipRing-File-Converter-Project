+| [`TRIGGER_KEYS`](../../history/%ED%98%B8%EB%B2%84%EB%8C%80%EB%B9%84-%EC%9E%91%EC%97%85%EC%A0%84/app.py#L39) | `정의=[     ("Shift", 0x10), ("Alt", 0x12), ("Ctrl", 0x11),     ("Windows", 0x5B), ("Space", 0x20), ("F8", 0x77), ("custom", -1), ]` |
