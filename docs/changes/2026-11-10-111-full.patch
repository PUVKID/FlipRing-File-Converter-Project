+def _plain_slide_text(document):
+    result = []
+    def visit(shape):
+        if hasattr(shape, "getString"):
+            value = shape.getString()
+            if value:
+                result.append(value)
+        if hasattr(shape, "getCount") and hasattr(shape, "getByIndex"):
+            for index in range(shape.getCount()):
