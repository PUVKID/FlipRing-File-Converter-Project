+"""문서 지원 안내·미리보기의 실제 Qt 표시와 입력 상태 보존 검사."""
+from pathlib import Path
+import tempfile
+import unittest
+
+from PySide6.QtCore import Qt, QRect
+from PySide6.QtWidgets import QApplication, QLabel
+import app
+from preview_panel import PreviewPanel
+
+
