+        current = self.pages_list.currentRow()
+        if not 0 <= current < workspace.page_count:
+            current = self.selected_page_indices()[0] if self.selected_page_indices() else 0
+        wanted = list(dict.fromkeys([current] + visible))[:12]
+        missing = []
+        for index in wanted:
