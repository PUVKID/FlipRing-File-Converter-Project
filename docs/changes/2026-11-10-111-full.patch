+        def add_file_arg(self, cmdline, filename):
+            cmdline.append(names.get(filename, filename))
+
+    config = dict(setup.setup)
+    config['open_cmd'] = (*config['open_cmd'], '-spd')
+    rarfile.CURRENT_SETUP = ExactNames(config)
