+class MonoFileIcons(QFileIconProvider):
+    """선택창 내부 파일 표시는 흑백으로 통일하며 실제 파일 형식은 Qt 모델이 보존한다."""
+
+    def __init__(self, language):
+        super().__init__()
+        self.language = language
