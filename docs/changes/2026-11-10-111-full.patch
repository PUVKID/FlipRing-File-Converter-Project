+            re.search(r'[<>:"/\\|?*\x00-\x1f]', value) or value[-1] in '. ' or
+            value in {'.', '..'} or
+            re.match(r'^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)', value, re.I)):
+        raise PdfToolError('output_name')
+    return value
