+def validate_recipe(recipe: dict) -> dict:
+    """코드·셸·임의 필드를 허용하지 않는 버전 1 JSON 레시피를 정규화한다."""
+    if not isinstance(recipe, dict) or set(recipe) != {"version", "name", "steps"}:
