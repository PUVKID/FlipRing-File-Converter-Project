+        self.items = []
+        self.error = ''
+        try:
+            data = json.loads(self.path.read_text(encoding='utf-8'))
+            if not isinstance(data, list): raise ValueError('프리셋 목록 형식 오류')
+            self.items = [self.validate(row) for row in data]
