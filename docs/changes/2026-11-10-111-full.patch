+                    tree.collect()
+                    check_cancel()
+                    if time.monotonic() >= deadline:
+                        raise RuntimeError("문서 변환 제한 시간 30분을 초과했습니다.")
+                    if cancel is not None:
+                        cancel.wait(0.05)
+                    else:
+                        time.sleep(0.05)
