+    extern      GOT_SYMBOL
+    call        %%geteip
+    add         %1, GOT_SYMBOL + $$ - $ wrt ..gotpc
+    jmp         short %%done
+%%geteip:
+    mov         %1, POINTER [esp]
+    ret
+%%done:
+%endmacro
+
+%endif    ; GOT_SYMBOL == _MACHO_PIC_ ----------------
+
+%imacro PUSHPIC 1.nolist
+    push        %1
+%endmacro
+%imacro POPPIC  1.nolist
+    pop         %1
+%endmacro
+%imacro MOVPIC  2.nolist
+    mov         %1, %2
+%endmacro
+
+%else    ; !PIC -----------------------------------------
+
+%define GOTOFF(got, sym)  (sym)
+
+%imacro GET_GOT 1.nolist
+%endmacro
+%imacro PUSHPIC 1.nolist
+%endmacro
+%imacro POPPIC  1.nolist
+%endmacro
+%imacro MOVPIC  2.nolist
+%endmacro
+
