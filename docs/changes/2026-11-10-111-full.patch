+
+
+def main():
+    root = Path(sys.argv[1])
+    root.mkdir(parents=True, exist_ok=False)
+    files = []
+    image = Image.new("RGBA", (48, 36), (180, 80, 30, 120))
+    for ext in "jpg png webp tiff avif bmp gif heic".split():
+        p = root / f"사진.{ext}"
+        if ext == "heic":
