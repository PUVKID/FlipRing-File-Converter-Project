+                raise ValueError('외부 BIN_LINK·미지원 저장소 개체는 변환하지 않습니다.')
+            item = BinDataItem.decode(data[offset:offset + size])
+            binary_streams.add('BinData/' + item.stream_name)
+        offset += size
+    return binary_streams
