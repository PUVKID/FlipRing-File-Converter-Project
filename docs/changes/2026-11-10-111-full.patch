+    ;   lea ecx, [ecx + ebp * 8 + (const_base - %%ref)] ; 8D, 8C, E9, (offset32)
+    db          0x8D, 0x8C              ; 8D, 8C
+    jmp         near const_base         ; E9, (const_base - %%ref)
