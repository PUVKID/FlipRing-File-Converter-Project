+
+_realname=winpthreads
+pkgbase=mingw-w64-${_realname}
+pkgname=("${MINGW_PACKAGE_PREFIX}-${_realname}" "${MINGW_PACKAGE_PREFIX}-libwinpthread")
+pkgver=14.0.0.r375.g9c1abbbf5
