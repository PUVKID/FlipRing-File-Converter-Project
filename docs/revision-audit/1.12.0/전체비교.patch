+class WorkspaceVisual(QWidget):
+    """파일 수와 실제 단계에 반응하는 유한 입체 카드 모션."""
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self.setMinimumHeight(106)
+        self.setMaximumHeight(106)
+        self.phase = 1.0
+        self.state = 'ready'
+        self.count = 0
+        self.formats = []
