+class _OwnedProcessTree(document_process._OfficeTree):
+    """새 도구의 Job 구성원 핸들을 보관하고 실제 종료 신호를 확인한다."""
+    def __init__(self, process):
+        self._operation_lock = threading.RLock()
+        super().__init__(process)
