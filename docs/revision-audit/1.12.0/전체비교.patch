+        from PySide6.QtWidgets import QWidget
+        from quick_actions_ui import QuickActionsPanel
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary); source = root / '원본.png'; Image.new('RGB', (20, 10)).save(source)
