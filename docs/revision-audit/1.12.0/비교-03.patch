+        for row in list(reversed(self.moves)):
+            try:
+                stored = safe_path(row["stored"])
+                original = safe_path(row["original"], exists=False)
+                if original.exists():
+                    raise ValueError("같은 이름의 파일이 있어 덮어쓰지 않았습니다: " + str(original))
+                if digest(stored) != row["sha256"]:
