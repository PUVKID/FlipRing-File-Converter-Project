+                self.moves.remove(row)
+                restored.append(path)
+                owned = self.rows.pop(row["original"], None)
+                if owned:
+                    owned["path"] = path
+                    self.rows[path] = owned
+            except (OSError, ValueError) as error:
+                errors.append(str(error))
+        return {"restored": restored, "errors": errors}
