+    ("메일용 JPG · 1600px / 1MiB", "jpg", 80, 1600, 1024 * 1024),
+    ("인쇄용 PDF · 원본 크기", "pdf", 95, 0, 0),
+    ("웹용 WebP · 1920px / 512KiB", "webp", 80, 1920, 512 * 1024),
