+    else:
+        with tarfile.open(output, "w:gz" if dst == "tar.gz" else "w") as z:
+            if prefix: z.add(root, arcname=prefix, recursive=False)
+            for p in entries: z.add(p, arcname=str(Path(prefix) / p.relative_to(root)), recursive=False)
+    return output
