+        elif dst in ("mp4", "mov", "mkv"): args += ["-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2", "-c:v", "libx264", "-crf", "20", "-pix_fmt", "yuv420p", "-c:a", "aac"] + (["-movflags", "+faststart"] if dst != "mkv" else [])
