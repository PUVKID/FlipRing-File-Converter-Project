+        QPalette.Text: "#171717", QPalette.Button: "#ffffff",
+        QPalette.ButtonText: "#171717", QPalette.Highlight: "#242424",
+        QPalette.HighlightedText: "#ffffff", QPalette.ToolTipBase: "#171717",
