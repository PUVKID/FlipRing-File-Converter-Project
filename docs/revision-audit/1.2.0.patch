+            if dst == "srt": start, end = start.replace(".", ","), end.replace(".", ",")
+            blocks.append((f"{i}\n" if dst == "srt" else "") + f"{start} --> {end}\n" + "\n".join(lines))
+        value = ("WEBVTT\n\n" if dst == "vtt" else "") + "\n\n".join(blocks) + "\n"
