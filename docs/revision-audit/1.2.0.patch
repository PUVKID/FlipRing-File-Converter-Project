+[Registry]
+Root: HKCU; Subkey: "Software\\Microsoft\\Windows\\CurrentVersion\\Run"; ValueName: "FlipRing"; Flags: uninsdeletevalue
+''', encoding="utf-8-sig")
+compiler = Path(os.environ.get("ISCC", ""))
