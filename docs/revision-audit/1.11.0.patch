+    def terminate(self):
+        # 종료 요청 전에 소유 핸들을 확보한다. Job의 활성 수만으로 종료를 판단하지 않는다.
+        with self._operation_lock:
+            if self.handle:
+                self.collect()
+                if not self.kernel.TerminateJobObject(self.handle, 1):
