+    def wait_empty(self, deadline):
+        while True:
+            with self._operation_lock:
+                active = self.collect()
+                waiting = False
+                for handle in self.process_handles.values():
+                    status = self.kernel.WaitForSingleObject(handle, 0)
+                    if status == 258:
