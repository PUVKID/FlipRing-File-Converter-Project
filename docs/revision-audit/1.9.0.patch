+class PanelTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        from PySide6.QtWidgets import QApplication
+        cls.application = QApplication.instance() or QApplication([])
+        cls.application.setQuitOnLastWindowClosed(False)
+
+    def setUp(self):
+        from pdf_panel import PdfToolsPanel
+        from PySide6.QtCore import QThread, Slot
+
+        class ObservingPanel(PdfToolsPanel):
+            def __init__(self):
+                self.affinity = []
+                super().__init__("ko")
+
+            @Slot(int, int, str)
+            def _on_progress(self, done, total, label):
+                self.affinity.append(("progress", QThread.currentThread() == self.thread()))
+                super()._on_progress(done, total, label)
+
+            @Slot(str, str, str)
+            def _on_result(self, source, output, error):
+                self.affinity.append(("result", QThread.currentThread() == self.thread()))
+                super()._on_result(source, output, error)
+
+            @Slot(object)
+            def _on_error(self, error):
+                self.affinity.append(("error", QThread.currentThread() == self.thread()))
+                super()._on_error(error)
+
+            @Slot(object)
+            def _finish(self, future):
+                self.affinity.append(("finish", QThread.currentThread() == self.thread()))
+                super()._finish(future)
+
+        self.panel = ObservingPanel()
+        self.events = []
+        self.panel.result_ready.connect(lambda source, output, error: self.events.append((source, output, error)))
+        self.panel.set_files([str(ROOT / "원본-페이지.pdf"), str(ROOT / "두번째.pdf")])
+
+    def tearDown(self):
+        if self.panel.is_busy():
+            self.panel.cancel()
+            self.wait_finished()
+        self.assertTrue(self.panel.shutdown(wait=True))
+        self.panel.hide()
+        self.panel.deleteLater()
+        self.application.processEvents()
+
+    def wait_finished(self):
+        from PySide6.QtCore import QAbstractEventDispatcher, QEventLoop, QTimer, Qt
+        # 실제 이벤트 루프에서 완료 슬롯 반환을 관찰하며 기존 10초 제한을 유지한다.
+        if not self.panel.is_busy():
+            return
+        loop = QEventLoop()
+        timer = QTimer(loop)
+        timer.setSingleShot(True)
+        timer.setTimerType(Qt.PreciseTimer)
+        dispatcher = QAbstractEventDispatcher.instance()
+        active = [True]
+        expired = [False]
+
+        def completion_gate(*unused):
+            if active[0] and not self.panel.is_busy():
+                loop.quit()
+
+        def timeout():
+            if active[0]:
+                expired[0] = True
+                loop.quit()
+
+        # 연결 전에 전송된 완료 신호도 기존 완료 슬롯이 반환한 뒤 관찰한다.
+        self.panel._bridge.finished.connect(completion_gate, Qt.QueuedConnection)
+        dispatcher.aboutToBlock.connect(completion_gate)
+        timer.timeout.connect(timeout)
+        try:
+            timer.start(10000)
+            if self.panel.is_busy():
+                loop.exec()
+        finally:
+            # 이미 큐에 든 콜백을 비활성화하고 타이머와 연결을 모두 정리한다.
+            active[0] = False
+            timer.stop()
+            timer.timeout.disconnect(timeout)
+            self.panel._bridge.finished.disconnect(completion_gate)
+            dispatcher.aboutToBlock.disconnect(completion_gate)
+        self.assertFalse(expired[0], "작업이 10초 안에 종료되지 않았습니다")
+        self.assertFalse(self.panel.is_busy())
+
