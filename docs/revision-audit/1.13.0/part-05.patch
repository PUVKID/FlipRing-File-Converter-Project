+def bounded_read(path, limit=MAX_FILE):
+    with Path(path).open('rb') as stream:
+        data = stream.read(limit + 1)
+    if not data or len(data) > limit:
+        raise ValueError('입력이 비어 있거나 크기 제한을 초과했습니다.')
+    return data
