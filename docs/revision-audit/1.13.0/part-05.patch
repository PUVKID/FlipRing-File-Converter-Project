+        if stat.S_ISLNK(info.st_mode) or getattr(info, 'st_file_attributes', 0) & 0x400:
+            raise ValueError('링크·재분석 경로는 문서 작업에 사용하지 않습니다.')
+    if not path.is_file():
+        raise ValueError('일반 문서 파일이 필요합니다.')
+    return path
