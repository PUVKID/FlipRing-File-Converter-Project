-def _inflate(data):
-    decoder = zlib.decompressobj(-15)
-    raw = decoder.decompress(data, MAX_FILE + 1)
-    if len(raw) > MAX_FILE or decoder.unconsumed_tail or not decoder.eof:
-        raise ValueError('HWP 압축 스트림이 손상되었거나 제한을 초과했습니다.')
-    return raw
