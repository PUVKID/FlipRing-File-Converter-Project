+            continue
+        href = item.get('href', '')
+        if (item.get('isEmbeded', '1') not in {'1', 'true'} or not href
+                or href != href.strip() or any(c in href for c in ('\\', ':', '%', '?', '#', '\x00'))
+                or href.startswith('/') or any(p in {'', '.', '..'} for p in href.split('/'))
