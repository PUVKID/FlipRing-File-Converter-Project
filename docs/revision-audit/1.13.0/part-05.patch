+        word = struct.unpack_from('<I', data, offset)[0]
+        offset += 4
+        size = word >> 20
+        if size == 0xfff:
+            if offset + 4 > len(data):
+                raise ValueError('잘린 HWP 확장 레코드 길이입니다.')
+            size = struct.unpack_from('<I', data, offset)[0]
+            offset += 4
+        if offset + size > len(data):
