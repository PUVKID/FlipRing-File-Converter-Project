+        self.animation.stop()
+        if abs(target - self.amount) < 0.001:
+            self.button.update()
+            return
+        with QSignalBlocker(self.animation):
+            self.animation.setStartValue(self.amount)
+            self.animation.setEndValue(target)
+            self.animation.setCurrentTime(0)
