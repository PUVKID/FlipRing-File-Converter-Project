+def file_urls(mime):
+    """드롭에 포함된 모든 항목이 존재하는 로컬 파일/폴더인지 확인한다."""
+    if not mime.hasUrls():
+        return []
+    urls = mime.urls()
+    if not urls or any(not url.isLocalFile() for url in urls):
+        return []
