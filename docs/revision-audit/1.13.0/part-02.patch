+        self._fade_page = page
+        effect = QGraphicsOpacityEffect(page)
+        effect.setOpacity(0.9)
+        page.setGraphicsEffect(effect)
+        self.fade.setStartValue(0.9)
+        self.fade.setEndValue(1.0)
+        start_motion(self.fade)
