-prepare() {
-  cd "${srcdir}"/${_sourcedir}
-
-  # 0002: https://gcc.gnu.org/git/?p=gcc.git;a=patch;h=b0f09b72d9e1783e8ccaf2d8c1c72b03e3973f0b;hp=e88f8d7bfc811f6d152c42ba009255506f5beba1
-  apply_patch_with_msg \
-    0002-i386-Keep-SEH-enabled-for-Win64-sysv_abi-functions.patch \
-    0003-Windows-Follow-Posix-dir-exists-semantics-more-close.patch \
-    0007-Build-EXTRA_GNATTOOLS-for-Ada.patch \
-    0008-Prettify-linking-no-undefined.patch \
-    0011-Enable-shared-gnat-implib.patch \
-    0012-Handle-spaces-in-path-for-default-manifest.patch \
-    0014-gcc-9-branch-clone_function_name_1-Retain-any-stdcall-suffix.patch \
-    0020-libgomp-Don-t-hard-code-MS-printf-attributes.patch \
-    0023-Ada-Don-t-export-gnat1-s-symbols-on-PE-hosts.patch \
-    0024-libgfortran-Guard-locale-restoration-for-formatted-I0.patch \
-    0025-libgfortran-Copy-LC_NUMERIC-string-for-formatted-IO.patch
-
-  # Avoid hardcoding /mingw or D:/M/${MINGW_PREFIX} in the final installation.
-  # Make GCC fully relocatable.
-  # See https://github.com/msys2/MINGW-packages/pull/29280 for details.
-  apply_patch_with_msg \
-    0021-bootstrap-gnattools-Pass-target-sysroot-flags-to-boo.patch \
-    0022-mingw-Remove-outdated-mingw-stuff.patch
