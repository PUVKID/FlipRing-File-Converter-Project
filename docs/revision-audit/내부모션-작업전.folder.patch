+            panel.output.showPopup()
+            APPLICATION.processEvents()
+            self.assertTrue(panel.output.view().isVisible())
+            target = panel.output.model().index(panel.output.findData("txt"), 0)
+            activated = QSignalSpy(panel.output.activated)
+            QTest.mouseMove(panel.output.view().viewport(),
+                            pos=panel.output.view().visualRect(target).center())
+            QTest.mouseClick(panel.output.view().viewport(), Qt.LeftButton,
+                             pos=panel.output.view().visualRect(target).center())
+            self.assertEqual(panel.output.currentData(), "txt")
+            self.assertEqual(activated.count(), 1)
+            self.assertFalse(panel.output.view().isVisible())
+        finally:
+            panel.output.hidePopup()
+            panel.operation.setCurrentIndex(panel.operation.findData(previous_operation))
+            self.window.resize(previous_size)
