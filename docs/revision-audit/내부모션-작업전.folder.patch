+        panel.operation.setCurrentIndex(panel.operation.findData("recognize"))
+        APPLICATION.processEvents()
+        try:
+            for focused in (False, True):
+                for widget in (panel.output, panel.dpi):
+                    panel.scroll.ensureWidgetVisible(widget)
+                    (widget if focused else self.window.nav_buttons[4]).setFocus()
+                    APPLICATION.processEvents()
+                    scrollbar = panel.scroll.verticalScrollBar()
+                    before_scroll = scrollbar.value()
+                    before_value = widget.currentData() if hasattr(widget, "currentData") else widget.value()
+                    direction = -120 if before_scroll < scrollbar.maximum() else 120
+                    position = widget.mapTo(self.window, widget.rect().center())
+                    QTest.wheelEvent(self.window.windowHandle(), QPointF(position), QPoint(0, direction))
+                    APPLICATION.processEvents()
+                    after_value = widget.currentData() if hasattr(widget, "currentData") else widget.value()
+                    self.assertEqual(after_value, before_value, "옵션 위 스크롤이 값을 바꿨습니다")
+                    self.assertNotEqual(scrollbar.value(), before_scroll, "휠이 옵션 스크롤로 전달되지 않았습니다")
+            panel.scroll.ensureWidgetVisible(panel.output)
+            panel.output.setCurrentIndex(panel.output.findData("pdf"))
