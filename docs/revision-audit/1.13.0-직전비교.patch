+                for index, (marker, segment) in enumerate(_jpeg_segments(raw)):
+                    check_cancel(cancel)
+                    if f'jpeg:{index}' in keys:
+                        continue
+                    payload = _jpeg_payload(segment) if marker == 0xE1 else b''
