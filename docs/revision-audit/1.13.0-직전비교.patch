+        name = '제출용.zip'
+        for number in range(1, 100000):
+            candidate = directory / (name if number == 1 else f'제출용 {number}.zip')
+            if os.path.normcase(str(candidate)) not in reserved and not candidate.exists():
+                rows.append({'source': '', 'path': str(candidate)})
