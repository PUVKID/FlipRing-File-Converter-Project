+        painter.drawLine(8, 5, 8, 3)
+        painter.drawLine(10, 8, 10, 14)
+        painter.drawLine(7, 11, 13, 11)
+    else:
+        for y in (5, 10, 15):
+            painter.drawPoint(4, y)
+            painter.drawLine(8, y, 17 if symbol == "list" else 13, y)
+            if symbol == "detail":
