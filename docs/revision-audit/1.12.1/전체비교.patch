+	
+	            int convertedLineWidth = Transform.translateHwp2Office(shape.lineThick);
+	            log.finest("Line width=" + convertedLineWidth + " from " + shape.lineThick + " in HWP.");
+	            // TextFrame
+	            // Line 566(2mm)
+	            // Curve 33(0.12mm)
+	            // Polygon
+	            xPropSet.setPropertyValue("LineWidth", convertedLineWidth);
