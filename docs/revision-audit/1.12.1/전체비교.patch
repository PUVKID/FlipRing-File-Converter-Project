+    def test_fresh_window_starts_simple_and_workspace_remains_accessible(self):
+        # 기존 준비 코드의 탭 강제 선택과 분리하여 새 창의 실제 시작 상태를 확인한다.
+        fresh = app.MainWindow()
+        fresh.timer.stop()
