+            }
+
+            // 캡션 쓰기
+            if (hasCaption) {
+                addCaptionString(wOuterContext, xInternalFrameText, xInternalFrameCursor, arc, step);
+            }
+        } catch (com.sun.star.uno.Exception e) {
+            log.log(Level.SEVERE, e.toString(), e);
+        } catch (SkipDrawingException e) {
+            log.log(Level.SEVERE, e.toString(), e);
+        }
+    }
