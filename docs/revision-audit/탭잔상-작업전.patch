+            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, r"Software\Microsoft\Windows\CurrentVersion\Run") as key:
+                return bool(winreg.QueryValueEx(key, AUTOSTART_NAME)[0])
+        except FileNotFoundError:
